# Copy this file to .env and fill in the values before running locally.
# Never commit .env — it is in .gitignore.

# ─── AI Providers ─────────────────────────────────────────────────────────────
# Each role picks its own provider independently: "gemini" or "openai"
# Enrichment = bulk background work (job enrichment, embeddings, matching)
# Generation = user-facing quality-critical work (CV, cover letters, parsing)
ENRICHMENT_AI_PROVIDER=openai
GENERATION_AI_PROVIDER=openai

# ─── OpenAI ───────────────────────────────────────────────────────────────────
# Create/rotate at https://platform.openai.com/api-keys
# Required when GENERATION_AI_PROVIDER=openai or ENRICHMENT_AI_PROVIDER=openai
OPENAI_API_KEY=sk-proj-...

# ─── Google Gemini ─────────────────────────────────────────────────────────────
# Get a free API key at https://aistudio.google.com/apikey
# Required when ENRICHMENT_AI_PROVIDER=gemini
GEMINI_API_KEY=

# ─── Database ─────────────────────────────────────────────────────────────────
# POSTGRES_PASSWORD is read by docker-compose.yml for the postgres container.
# DB_PASS is read by Spring Boot. Both must match.
DB_URL=jdbc:postgresql://localhost:5432/autoapplicant
DB_USER=autoapplicant
DB_PASS=changeme
POSTGRES_PASSWORD=changeme

# ─── Typesense ────────────────────────────────────────────────────────────────
TYPESENSE_API_KEY=local-dev-key
TYPESENSE_HOST=localhost
TYPESENSE_PORT=8108

# ─── Firebase (Web SDK — frontend build args) ─────────────────────────────────
# Find in: Firebase console → Project settings → General → Your apps → Config
FIREBASE_API_KEY=AIzaSy...
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=000000000000
FIREBASE_APP_ID=1:000000000000:web:...

# ─── Firebase (Server SDK — backend) ──────────────────────────────────────────
# Download from: Firebase console → Project settings → Service accounts → Generate new private key
# Place the JSON at: .secrets/firebase-service-account.json
# Required for ./gradlew bootRun and aac-crawl (Docker sets this automatically via volume mount)
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\akash\IdeaProjects\AutoApplicant\.secrets\firebase-service-account.json

# ─── Optional ─────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:4200
# LINKEDIN_CLIENT_ID=your-linkedin-client-id
# LINKEDIN_CLIENT_SECRET=your-linkedin-client-secret
# CAREERJET_AFFILIATE_ID=
