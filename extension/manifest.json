{
  "manifest_version": 3,
  "name": "Jobbuddy Job Capture",
  "version": "0.1.0",
  "description": "Capture the job posting you're looking at and send it to Jobbuddy — ready to generate a tailored CV and application.",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Capture this job in Jobbuddy"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:4200/*", "http://localhost/*"],
      "js": ["capture-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
