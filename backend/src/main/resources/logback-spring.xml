<?xml version="1.0" encoding="UTF-8"?>
<!--
  There was no logging configuration at all, which meant Spring Boot's default: console only.
  Nothing was written to disk, so a crawl that ran overnight left no evidence of what it did
  once the terminal scrolled — and no way to tell a finished run from a dead one.

  Three files, because the volumes are wildly different. A crawl writes a line per source; the
  enrichment worker writes a progress line every 30 seconds for hours. Interleaved, the second
  buries the first.
-->
<configuration>
    <property name="LOG_DIR" value="${LOG_DIR:-logs}"/>
    <property name="PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{36} - %msg%n"/>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <!-- One appender per concern; all three roll daily and cap total history. -->
    <appender name="APP_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/application.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/application.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>14</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <appender name="CRAWLER_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/crawler.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/crawler.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <appender name="ENRICHMENT_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/enrichment.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/enrichment.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>20MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder><pattern>${PATTERN}</pattern></encoder>
    </appender>

    <!--
      additivity="false" keeps crawler and enrichment lines out of application.log, so that file
      stays readable. They still reach the console, which is what a manual run is watching.
    -->
    <logger name="com.autoapplicant.adapter.crawler" level="INFO" additivity="false">
        <appender-ref ref="CRAWLER_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <logger name="com.autoapplicant.usecase.job" level="INFO" additivity="false">
        <appender-ref ref="ENRICHMENT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <!-- The embedding worker is enrichment's sibling and belongs in the same file. -->
    <logger name="com.autoapplicant.usecase.job.JobEmbeddingService" level="INFO" additivity="false">
        <appender-ref ref="ENRICHMENT_FILE"/>
        <appender-ref ref="CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="APP_FILE"/>
    </root>
</configuration>
